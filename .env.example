# Copy to `.env` and fill in (never commit real secrets).
# Load in app code via `process.env` only on the server, or use Meteor settings for non-secret config.

# App runtime configuration
PORT=3000
ROOT_URL=http://localhost:3000
NODE_ENV=development
MONGO_URL=mongodb://127.0.0.1:27017/escapesnap

# Optional Meteor settings JSON
# METEOR_SETTINGS={"private":{"comment":"Server-only keys"}}

# Google Cloud Vision (optional — for photo validation)
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# AWS Rekognition (optional — alternative to Vision)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-southeast-2

# Gemini API — used by server/main.js to verify submitted photos
GEMINI_API_KEY=
# Optional — defaults to gemini-3-flash-preview if unset
# GEMINI_MODEL=gemini-3-flash-preview
