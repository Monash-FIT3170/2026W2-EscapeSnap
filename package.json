{
  "name": "2026W2-EscapeSnap",
  "private": true,
  "scripts": {
    "start": "node scripts/start.mjs",
    "patch:meteor-win": "powershell -ExecutionPolicy Bypass -File ./scripts/patch-meteor-win-npm.ps1",
    "start:windows": "powershell -ExecutionPolicy Bypass -File ./scripts/start-windows.ps1",
    "lint": "eslint . --ext .js,.jsx",
    "test": "npm run test:unit && npm run test:ui && npm run test:meteor",
    "test:unit": "node --experimental-default-type=module --test imports/api/achievements/calculateGameResults.test.js imports/lib/answerModes.test.js imports/api/submissions/classifyPrompt.test.js imports/api/gemini/geminiModels.test.js imports/lib/customTheme.test.js imports/api/riddles/roundRiddlePrompt.test.js imports/ui/mobile/components/result/shareSnapshot.test.js imports/ui/mobile/components/result/shareCard.test.js imports/ui/host/components/landing/landingLogic.test.js",
    "test:ui": "vitest run",
    "test:meteor": "cross-env TEST_CLIENT=0 meteor test --once --driver-package meteortesting:mocha",
    "test:e2e": "playwright test -c e2e/playwright.config.js",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.js --ui",
    "test:e2e:demo": "cross-env E2E_DEMO=1 playwright test -c e2e/playwright.config.js",
    "test:e2e:report": "playwright show-report e2e/playwright-report",
    "format": "prettier --write '**/*.{js,jsx,css,md}'"
  },
  "dependencies": {
    "@babel/runtime": "^8.0.7",
    "@tailwindcss/postcss": "^4.3.3",
    "daisyui": "^5.7.48",
    "meteor-node-stubs": "^1.2.30",
    "postcss": "^8.5.30",
    "postcss-load-config": "^6.0.1",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "react-router-dom": "^7.18.4",
    "simpl-schema": "^3.4.7",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitest/coverage-v8": "^5.0.4",
    "chai": "^6.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "vitest": "^5.0.4"
  }
}
